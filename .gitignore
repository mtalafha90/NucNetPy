htmlcov/

# Built documentation.  The rendered manual for a submission archive is kept at
# docs/manual/nucnetpy-manual.pdf; everything else is regenerated by
# `make -C docs/manual all`.
docs/manual/_build/

# Editors, notebooks and virtual environments
.ipynb_checkpoints/
.venv/
venv/
.DS_Store

# Local data and results.  The JINA database is not redistributed here, and
# the commands in the README and the manual write their files next to it, in
# the top folder: combined networks, HDF5 output and the results of the
# scripts in validation/.  Notebook 08 reads the database from notebooks/data/.
/*.xml
/*.h5
/*.hdf5
/results/
/benchmark.json
/benchmark.tex
/real_xml_validation_summary.json
notebooks/data/nuclides.xml
notebooks/data/reaction_data.xml
notebooks/data/zone.xml
